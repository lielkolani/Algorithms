<!DOCTYPE html>
<html lang="he">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Algorithms</title>
    <script type="importmap"></script>
    <!-- Bootstrap 5.3.3 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Algorithms.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark w-100 px-0 border-bottom shadow" dir="rtl">
        <div class="container-fluid px-3 w-100">
            <!-- Brand (Sits flush right with pe-0) -->
            <a class="navbar-brand fw-bold text-light pe-0 m-0" href="/Index">אלגוריתמים</a>

            <!-- Mobile Toggler Button -->
            <button class="navbar-toggler border-0 ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Collapsible Content -->
            <div class="collapse navbar-collapse justify-content-between" id="navbarSupportedContent">
                <!-- Main Algorithm Links -->
                <ul class="navbar-nav mb-2 mb-lg-0 gap-1 gap-xl-2">
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/NumberGuess">נחש את המספר</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/BinarySearch">חיפוש בינארי</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/Complexity">סיבוכיות</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/BubbleSort">מיון בועות</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/RandomQuickSort">מיון מהיר אקראי</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/DeterministicQuickSort">מיון מהיר דטרמיניסטי</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/MergeSort">מיון מיזוג</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/InsertionSort">מיון הכנסה</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/Recursion">רקורסיה</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/Recursion">הצפנה</a>
                    </li
                    <li class="nav-item">
                        <a class="nav-link link-light link-opacity-100 link-opacity-75-hover px-2" href="/HTML/Recursion">דחיסת קבצים</a>
                    </li>
                </ul>

                <!-- Secondary Links & Icon (Login / Registration) -->
                <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center gap-2" dir="ltr">
                    <li class="nav-item d-none d-lg-block">
                        <img src="/images/icon.png" width="50" height="50" style="width: 50px; height: 50px; object-fit: contain;" alt="Icon" />
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light text-decoration-underline px-2" href="/HTML/Login">התחברות</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light text-decoration-underline px-2" href="/HTML/Registration">הרשמה</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4" dir="rtl">
        <main role="main" class="pb-3 text-end">
            @RenderBody()
        </main>
    </div>

    <!-- jQuery and Single Bootstrap Bundle JS CDN -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>